# Copie para .env.local e ajuste. Nunca comite .env.local.

# Raiz do motor B-O-S (contém clientes/, _memoria/, identidade/, .claude/skills/)
# Relativo à pasta do app ou caminho absoluto.
BOS_ROOT=../B-O-S

# Credenciais do operador da agência (Console / MODO OWNER)
OWNER_EMAIL=admin@agencia.com
OWNER_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessão (gere algo longo e aleatório)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Chave da Anthropic para o módulo Claude Code (Agent SDK).
# Se ausente, o app tenta ler ANTHROPIC_API_KEY do .env do B-O-S.
# ANTHROPIC_API_KEY=sk-ant-...

# App próprio no Meta for Developers (developers.facebook.com), usado só para
# RENOVAR sozinho o token de longa duração do Instagram de cada cliente antes
# de vencer (~60 dias). Sem isso configurado, o token do Instagram de todo
# cliente expira periodicamente e precisa ser regerado na mão em
# Configurações → Instagram (API) — ver o passo 4b do tutorial lá.
# META_APP_ID=...
# META_APP_SECRET=...

# Evolution API (WhatsApp) — UM servidor compartilhado pela instalação
# inteira, cada cliente ganha a própria "instance" lá dentro. Sem isso
# configurado, a aba WhatsApp do CRM fica honestamente desligada. Passo a
# passo de instalação na VPS: docs/WHATSAPP-EVOLUTION-API.md.
# EVOLUTION_API_URL=https://seu-evolution-api.seudominio.com.br
# EVOLUTION_API_KEY=a-mesma-AUTHENTICATION_API_KEY-que-voce-configurou-la

# Endereço público deste Hub (sem barra no final) — o Evolution API precisa
# saber pra onde mandar o webhook de cada instância. Só funciona com uma URL
# de verdade, alcançável pela internet (não localhost).
# HUB_URL=https://seuhub.seudominio.com.br

# Segredo simples pra proteger a rota de cron das automações do WhatsApp
# (POST /api/cron/whatsapp-automacoes, header x-cron-secret) — gere uma
# string aleatória. Sem isso configurado, a rota fica bloqueada (500) de
# propósito, nunca aberta sem proteção nenhuma.
# CRON_SECRET=troque-por-uma-string-longa-e-aleatoria
